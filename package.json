{
  "name": "king-queen-voting",
  "version": "1.0.0",
  "description": "Simple King and Queen college voting API starter",
  "main": "server.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "prod": "cross-env NODE_ENV=production node server.js",
    "import:queens": "node scripts/importQueenCandidates.js",
    "mongo:start": "node scripts/localMongo.cjs start",
    "test:auth": "node scripts/runAuthChecks.cjs",
    "test:auth:api": "node scripts/runAuthChecks.cjs --no-browser",
    "test:all": "npm test && npm run test:auth && npm --prefix frontend test && npm --prefix admin test && python3 -m unittest discover -s deploy -p \"test_*.py\" && npm run test:nginx",
    "test:nginx": "node scripts/checkNginx.cjs",
    "mongo:stop": "node scripts/localMongo.cjs stop",
    "mongo:restart": "node scripts/localMongo.cjs restart",
    "mongo:status": "node scripts/localMongo.cjs status"
  },
  "type": "commonjs",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "morgan": "^1.11.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14"
  }
}

    {
      "name": "04 Memory Admin logs in through the existing admin login",
      "request": {
        "method": "POST",
        "url": "{{base_url}}/api/v1/auth/admin/login",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "description": "Expected HTTP 200. Database role governs authorization; no client-selected role is trusted.",
        "body": {
          "mode": "raw",
          "raw": "{{memory_admin_body}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of ['memory_admin_username','memory_admin_password']) if (!pm.variables.get(key)) throw new Error('Set ' + key + ' privately first.');",
              "pm.variables.set('memory_admin_body', JSON.stringify({username:pm.variables.get('memory_admin_username'),password:pm.variables.get('memory_admin_password')}));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const body = pm.response.json();",
              "pm.test('Response status', () => pm.expect(body.status).to.eql('success'));",
              "pm.test('Database role is MEMORY_ADMIN', () => pm.expect(body.data.admin.role).to.eql('MEMORY_ADMIN'));",
              "pm.test('Bearer token returned', () => pm.expect(body.data.token).to.be.a('string').and.not.empty);",
              "pm.variables.set('memory_admin_token', body.data.token);",
              "}"
            ]
          }
        }
      ]
    },

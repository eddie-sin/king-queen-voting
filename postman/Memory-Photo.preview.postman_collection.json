          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const body = pm.response.json();",
              "pm.test('Response status', () => pm.expect(body.status).to.eql('success'));",
              "pm.test('Review saved', () => { pm.expect(body.data.photo.status).to.eql('APPROVED'); pm.expect(body.data.photo.reviewedBy).to.match(/^[a-f0-9]{24}$/); pm.expect(Number.isFinite(Date.parse(body.data.photo.reviewedAt))).to.eql(true); pm.expect(body.data.photo).not.to.have.property('imageKey'); });",
              "pm.test('Audit records the Memory Admin', () => pm.expect(body.data.photo.reviewedBy).to.eql(pm.variables.get('memory_admin_id')));",
              "}"
            ]
          }
        }
      ]

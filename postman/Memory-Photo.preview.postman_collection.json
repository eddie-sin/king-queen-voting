        "url": "{{base_url}}/api/v1/admin/memory-photos/{{photo_id}}/review",
        "description": "Expected HTTP 200. Run in collection order against a dedicated test database.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"APPROVED\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get('memory_admin_token')) throw new Error('Log in as admin first.');"

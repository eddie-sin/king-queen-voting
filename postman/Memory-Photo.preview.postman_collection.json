{
  "info": {
    "_postman_id": "548e8eea-22fe-413e-aa9d-65e8e8635753",
    "name": "Memory Photo - manual local preview",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run requests individually in order against the isolated preview only. No contestant, gallery, voting or data-reset mutations. Reuses the canonical Memory Photo requests. Moderator account is provisioned by the preview launcher."
  },
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "01 Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        },
        "url": "{{base_url}}/api/v1/auth/admin/login",
        "description": "Expected HTTP 200. Run in collection order against a dedicated test database.",
        "body": {
          "mode": "raw",
          "raw": "{{login_body}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.variables.get('admin_username')) throw new Error('Set admin_username privately in the selected environment.');",
              "if (!pm.variables.get('admin_password')) throw new Error('Set admin_password privately in the selected environment.');",
              "pm.variables.set('login_body', JSON.stringify({ username: pm.variables.get('admin_username'), password: pm.variables.get('admin_password') }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); } else {",
              "const body = pm.response.json();",
              "pm.test('Response status', () => pm.expect(body.status).to.eql('success'));",
              "pm.test('Bearer token returned', () => pm.expect(body.data.token).to.be.a('string').and.not.empty); pm.variables.set('admin_token', body.data.token);",
              "pm.test('Full admin role preserved', () => pm.expect(body.data.admin.role).to.eql('ADMIN'));",
              "}"
            ]
          }
        }
      ]
    },

NODE_ENV=development
PORT=5000

# Transactions require Atlas or a replica set, including local development.
DATABASE_LOCAL=mongodb://127.0.0.1:27017/king_queen_voting?replicaSet=rs0
DATABASE=mongodb+srv://YOUR_CLUSTER/king_queen_voting
DATABASE_PASSWORD=

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=5h

# Required to seed the first admin; never commit your real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

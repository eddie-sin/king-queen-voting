NODE_ENV=development
PORT=5000

# Use a separate empty v2 database on a replica set. Never point this version at legacy data.
DATABASE_LOCAL=mongodb://127.0.0.1:27018/king_queen_voting_v2?replicaSet=kqvLocal
DATABASE=mongodb+srv://YOUR_DB_USER:<db_password>@YOUR_CLUSTER/king_queen_voting_v2?retryWrites=true&w=majority
DATABASE_PASSWORD=

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=5h

# Required to seed the first admin; never commit your real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Only production uploads require S3 configuration.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# Optional override; defaults to this project's ignored uploads/ directory.
LOCAL_UPLOAD_DIR=

# Student authentication. Local testing uses this exact origin and port.
# Before public deployment set AUTH_ORIGIN to https://gusto-thadingyut-festival.eddiespace.com.
# Set production only in the prepared server configuration; local npm run prod is still allowed.
AUTH_ENVIRONMENT=local
AUTH_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID_DEVELOPMENT=YOUR_DEVELOPMENT_WEB_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_ID_PRODUCTION=YOUR_PRODUCTION_WEB_CLIENT_ID.apps.googleusercontent.com
AUTH_EMAIL_FROM="GUSTO Thadingyut Festival <noreply@auth.eddiespace.com>"
RESEND_API_KEY=YOUR_DOMAIN_RESTRICTED_SEND_ONLY_KEY
# Generate two separate random 32-byte hex secrets. Never commit actual secrets.
AUTH_OTP_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
AUTH_MAIL_SECRET=REPLACE_WITH_DIFFERENT_64_HEX_CHARACTERS

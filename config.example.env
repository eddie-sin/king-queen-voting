NODE_ENV=development
PORT=5000

# A normal standalone MongoDB server is supported.
DATABASE_LOCAL=mongodb://127.0.0.1:27017/king_queen_voting
DATABASE=mongodb+srv://YOUR_DB_USER:<db_password>@YOUR_CLUSTER/king_queen_voting?retryWrites=true&w=majority
DATABASE_PASSWORD=

JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=5h

# Required to seed the first admin; never commit your real values.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD

# Only production uploads require S3 configuration.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_URL=

# Optional override; defaults to this project's ignored uploads/ directory.
LOCAL_UPLOAD_DIR=

# Memory Photo private storage (not used by existing candidate/gallery uploads).
MEMORY_PHOTO_STORAGE_DRIVER=
MEMORY_PHOTO_S3_BUCKET=
MEMORY_PHOTO_S3_REGION=
MEMORY_PHOTO_SIGNED_URL_TTL_SECONDS=
MEMORY_PHOTO_LOCAL_STORAGE_DIR=
MEMORY_PHOTO_LOCAL_SIGNING_SECRET=
MEMORY_PHOTO_UPLOAD_FINGERPRINT_SECRET=
MEMORY_PHOTO_ORPHAN_GRACE_SECONDS=
MEMORY_PHOTO_MAX_INPUT_BYTES=
MEMORY_PHOTO_MAX_OUTPUT_BYTES=
MEMORY_PHOTO_MAX_PIXELS=
MEMORY_PHOTO_MAX_WIDTH=
MEMORY_PHOTO_MAX_HEIGHT=
MEMORY_PHOTO_MAX_RESERVATION_SECONDS=
MEMORY_PHOTO_CLOCK_SKEW_SECONDS=
